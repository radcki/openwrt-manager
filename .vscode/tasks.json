{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lint with Ruff",
      "type": "shell",
      "command": "uv run ruff check .",
      "problemMatcher": ["$ruff"],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Format with Ruff",
      "type": "shell",
      "command": "uv run ruff format .",
      "problemMatcher": []
    },
    {
      "label": "Type check with mypy",
      "type": "shell",
      "command": "uv run mypy custom_components/openwrt_manager",
      "problemMatcher": ["$mypy"]
    },
    {
      "label": "Start Home Assistant Docker",
      "type": "shell",
      "command": "docker compose up -d",
      "problemMatcher": []
    },
    {
      "label": "Stop Home Assistant Docker",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    }
  ]
}
